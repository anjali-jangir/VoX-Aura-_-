# ── VoxAura AI Voice Studio · environment config ──
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env to git — it holds your secret API key.

# Voice provider: "auto" = Microsoft Edge neural voices with Google TTS as
# automatic fallback. FREE, no API key, no quota (default, just works).
# Options: auto | edge | google | elevenlabs
# "elevenlabs" = premium quality, but needs ELEVENLABS_API_KEY + paid credits.
TTS_PROVIDER=auto

# Your ElevenLabs API key (elevenlabs.io → Profile → API Keys)
# Only needed when TTS_PROVIDER=elevenlabs. The key is read ONLY by
# server.js and is never sent to the browser.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# ElevenLabs model to use (eleven_multilingual_v2 supports 29 languages)
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Port the studio runs on
PORT=3000
